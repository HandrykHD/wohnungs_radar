# Kopiere diese Datei nach .env und trage deine Werte ein.
# .env ist in .gitignore und wird NIEMALS committet.

# --- Pflicht: Kontaktadresse für Nominatim/Overpass ---
# Die Nutzungsbedingungen von OpenStreetMap verlangen einen identifizierbaren
# User-Agent mit Kontaktmöglichkeit. Ohne gültige Adresse droht ein IP-Bann.
OSM_CONTACT_EMAIL=deine.mail@example.com

# --- Optional: OpenRouteService (Alternative zum öffentlichen OSRM) ---
# Kostenloser Key: https://openrouteservice.org/dev/#/signup
# Leer lassen, um den öffentlichen OSRM-Demo-Server zu nutzen.
ORS_API_KEY=

# --- Optional (spätere Ausbaustufe): Telegram-Benachrichtigungen ---
# Token via @BotFather, Chat-ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
